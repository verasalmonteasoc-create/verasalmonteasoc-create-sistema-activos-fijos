# ========== ENTORNO ==========
FLASK_ENV=development
DEBUG=True

# URL pública del sitio (usada para generar los códigos QR de activos).
# En producción, poner el dominio real, ej: https://activos.miempresa.com
APP_BASE_URL=

# ========== BASE DE DATOS ==========
DB_HOST=postgres
DB_PORT=5432
DB_NAME=asset_management
DB_USER=postgres
DB_PASSWORD=postgres123

# ========== SEGURIDAD ==========
SECRET_KEY=dev-secret-key-change-in-production-use-secrets-management
SESSION_COOKIE_SECURE=False
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000

# ========== LOGGING ==========
LOG_LEVEL=INFO
LOG_TO_STDOUT=False

# ========== ARCHIVOS ==========
UPLOAD_FOLDER=backend/uploads
MAX_CONTENT_LENGTH=52428800

# ========== FEATURES ==========
MAINTENANCE_MODE=False
